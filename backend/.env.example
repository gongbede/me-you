ME_YOU_ENV=development
ME_YOU_DATABASE_URL=postgresql+asyncpg://me_you:placeholder-local-password@localhost:5432/me_you
ME_YOU_JWT_SECRET_KEY=placeholder-local-development-secret
ME_YOU_CORS_ORIGINS=http://localhost:3000
# Trust no reverse proxies by default. If set above 0, X-Forwarded-For is trusted
# and the client address is selected from that many proxy hops from the right.
TRUSTED_PROXY_COUNT=0
RATE_LIMIT_ENABLED=true
LOGIN_PAIR_FAILURE_LIMIT=5
LOGIN_PAIR_WINDOW_SECONDS=900
LOGIN_IP_ATTEMPT_LIMIT=30
LOGIN_IP_WINDOW_SECONDS=900
LOGIN_EMAIL_FAILURE_LIMIT=50
LOGIN_EMAIL_WINDOW_SECONDS=3600
REGISTRATION_IP_LIMIT=5
REGISTRATION_WINDOW_SECONDS=3600
PASSWORD_CHANGE_IP_LIMIT=5
PASSWORD_CHANGE_WINDOW_SECONDS=3600
API_IP_LIMIT=120
API_WINDOW_SECONDS=60
SECURITY_EVENT_RETENTION_DAYS=365
ME_YOU_PUBLIC_BASE_URL=http://localhost:3000
# Optional: provider adapter names are accepted only when a concrete adapter is installed.
ME_YOU_EMAIL_PROVIDER=
# Optional: configure only when MongoDB-backed features are used.
# ME_YOU_MONGODB_URI=mongodb://localhost:27017